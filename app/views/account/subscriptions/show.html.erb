<% @page_title = "Thank you" %>

<% if @session&.payment_status == "paid" %>
  <section class="panel panel--centered center borderless">
    <h1 class="txt-x-large font-weight-black margin-none">Thanks for buying Fizzy!</h1>
    <p class="txt-medium margin-none-block-start">Your payment was successful. You’re now on the <strong><%= @account.plan.name %></strong> plan.</p>
    <%= link_to "Done", account_settings_path, class: "btn btn--reversed txt-medium", style: "--btn-background: var(--color-card-6)" %>
  </section>
<% end %>

